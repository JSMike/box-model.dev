{
  "name": "@box-model/web",
  "version": "0.0.1",
  "description": "Accessible, framework-agnostic web components for the Box Model design system.",
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "customElements": "./custom-elements.json",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSMike/box-model.dev.git",
    "directory": "libs/web"
  },
  "homepage": "https://box-model.dev",
  "bugs": {
    "url": "https://github.com/JSMike/box-model.dev/issues"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "design-system",
    "accessible",
    "tanstack-intent"
  ],
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    "./custom-elements.json": {
      "default": "./custom-elements.json"
    },
    "./styles/*": {
      "default": "./styles/*"
    },
    "./react": {
      "types": "./types/react.d.ts"
    },
    "./preact": {
      "types": "./types/preact.d.ts"
    },
    "./solid": {
      "types": "./types/solid.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@tanstack/intent": "0.3.6"
  }
}
