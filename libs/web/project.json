{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["tokens"],
  "targets": {
    "build": {
      "dependsOn": ["build-lib", "build-storybook"]
    },
    "generate-types": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["CEM_STRICT=1 tsx libs/web/generators/generate-all.ts"],
        "parallel": false
      }
    },
    "validate-skill": {
      "executor": "nx:run-commands",
      "options": {
        "command": "intent validate",
        "cwd": "libs/web"
      }
    },
    "validate-skill-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-lib"],
      "options": {
        "command": "intent validate",
        "cwd": "dist/libs/web"
      }
    },
    "build-lib": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/web",
        "viteConfig": "libs/web/vite.config.ts"
      },
      "dependsOn": ["generate-types", "^build-lib"]
    },
    "storybook": {
      "executor": "@nx/storybook:storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/web/.storybook"
      },
      "dependsOn": ["^build"]
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/web",
        "configDir": "libs/web/.storybook"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-a11y": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook"],
      "options": {
        "command": "node libs/web/accessibility/axe-storybook.mjs"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "vitestConfig": "libs/web/vite.config.ts",
        "passWithNoTests": true
      },
      "dependsOn": ["^build"]
    }
  }
}
