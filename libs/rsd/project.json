{
  "name": "rsd",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/rsd/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["tokens", "web"],
  "targets": {
    "build": {
      "dependsOn": ["build-lib", "build-storybook"]
    },
    "build-lib": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["^build-lib"],
      "options": {
        "outputPath": "dist/libs/rsd",
        "viteConfig": "libs/rsd/vite.config.ts"
      }
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-lib"],
      "options": {
        "command": "node libs/rsd/scripts/verify-package.mjs"
      }
    },
    "storybook": {
      "executor": "@nx/storybook:storybook",
      "dependsOn": ["^build"],
      "options": {
        "port": 4401,
        "configDir": "libs/rsd/.storybook"
      }
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/rsd",
        "configDir": "libs/rsd/.storybook"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "dependsOn": ["^build"],
      "options": {
        "config": "libs/rsd/vite.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
