{
  "name": "box-model-web-vite",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/box-model-web-vite/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project box-model-web-vite --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/out-tsc/apps/box-model-web-vite",
        "{workspaceRoot}/dist/out-tsc/libs/web"
      ],
      "options": {
        "cwd": "apps/box-model-web-vite",
        "command": "tsc --build tsconfig.app.json --emitDeclarationOnly"
      }
    }
  }
}
